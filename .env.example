# ============================================================================
# TCOC Application — Environment Configuration Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local   (Mac/Linux)
#                       copy .env.example .env.local  (Windows)
#   2. Edit .env.local with your settings
#   3. Restart the dev server: npm run dev
#
# POLICY: .env.local is gitignored and must never be committed.
# REALITY as of 2026-09-28: .env.local IS currently tracked in this repo, so the
# line above describes intent, not state. Until it is untracked, treat everything
# in .env.local as published. Real secrets belong in .env (gitignored) only.
# ============================================================================

# ============================================================================
# MASTER DATA SOURCE SWITCH
# ----------------------------------------------------------------------------
# DEMO MODE  → set both to true  (no Docker, no FHIR server, all screens work)
# PRODUCTION → set both to false (requires Docker backbone — see install/)
# ============================================================================
NEXT_PUBLIC_USE_MOCK_DATA=true
ALLOW_DEV_MOCK_AUTH=true

# ============================================================================
# FHIR SERVER
# ----------------------------------------------------------------------------
# After cloning, start the local FHIR server:
#   docker compose -f fhir/docker-compose.yml up -d
# Then seed patient data:
#   node fhir/migrate-patients.mjs
# ============================================================================
NEXT_PUBLIC_FHIR_BASE_URL=http://localhost:8080/fhir
NEXT_PUBLIC_FHIR_TIMEOUT=30000
NEXT_PUBLIC_FHIR_RETRY_ATTEMPTS=3

# ============================================================================
# SMART ON FHIR (OAuth 2.0) — leave as-is for local dev
# ============================================================================
NEXT_PUBLIC_SMART_CLIENT_ID=tcoc-client
NEXT_PUBLIC_SMART_REDIRECT_URI=http://localhost:4029/md-smart-launch
NEXT_PUBLIC_SMART_SCOPE=launch launch/patient patient/*.read openid fhirUser offline_access

# ============================================================================
# CDS HOOKS
# ============================================================================
NEXT_PUBLIC_ENABLE_CDS_HOOKS=true
NEXT_PUBLIC_CDS_HOOKS_ENDPOINT=http://localhost:8080/cds-services
NEXT_PUBLIC_CDS_HOOKS_TIMEOUT=10000

# ============================================================================
# PRIOR AUTHORIZATION (CRD · DTR · PAS — /prior-auth)
# ----------------------------------------------------------------------------
# The PA workflow is built into the RHTP app — no separate process needed.
#
# DTR /api/dtr/evaluate route:
#   DEMO mode (USE_MOCK_DATA=true):  serves Maria's CPT 72148 scenario inline
#   LIVE mode (USE_MOCK_DATA=false): calls Policy Engine at POLICY_ENGINE_URL
#
# POLICY_ENGINE_URL — only needed in live mode (Policy Engine must be running,
# see PA-Standalone-SmartApp/services/policy-engine/). Leave blank for demo.
# POLICY_ENGINE_URL=http://localhost:8083
#
# Legacy standalone SmartApp launch URL (kept for reference; not required for
# the integrated /prior-auth experience):
# NEXT_PUBLIC_PA_SMARTAPP_URL=http://localhost:4032/launch?iss=http%3A%2F%2Flocalhost%3A8080%2Ffhir&launch=patient-rachel-green

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_FLAG_PATIENT_ACCESS=true
NEXT_PUBLIC_FLAG_PROVIDER_ACCESS=true
NEXT_PUBLIC_FLAG_PAYER_TO_PAYER=true
NEXT_PUBLIC_FLAG_PRIOR_AUTH=true
NEXT_PUBLIC_FLAG_AI_DTR=false
NEXT_PUBLIC_FLAG_GOLDEN_THREAD=true
NEXT_PUBLIC_FLAG_NETWORK_ADEQUACY=true
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=false
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=false
NEXT_PUBLIC_ENABLE_MCP_TOOLS=false

# ============================================================================
# SECRETS — CHANGE BEFORE ANY SHARED/PRODUCTION USE
# ----------------------------------------------------------------------------
# SESSION_SECRET must be 32+ random characters. The values below are
# development placeholders only — never use them outside local dev.
# ============================================================================
SESSION_SECRET=dev-only-change-me-please-32chars-min
WEBHOOK_SHARED_SECRET=dev-webhook-secret-change-me

# ============================================================================
# DEVELOPER / DEBUG
# ============================================================================
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true
NEXT_PUBLIC_SHOW_DATA_SOURCE_INDICATOR=true

# ============================================================================
# AI ASSISTANT (server-side only — NEVER prefix these NEXT_PUBLIC_)
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY is read ONLY on the server:
#   src/app/api/policy/assistant/route.ts   (BFF route)
#   src/lib/goldenThread/dtr/generator.ts
#   src/lib/policy/review/codingMap.ts
# It has no NEXT_PUBLIC_ prefix on purpose, so it never reaches the browser
# bundle. If you ever see NEXT_PUBLIC_ANTHROPIC_API_KEY anywhere, that is a
# defect — the key would ship to every visitor.
#
# PUT THE REAL VALUE IN .env ONLY. That file is gitignored (.gitignore:86).
# Do NOT put it here, and do NOT put it in .env.local — .env.local is
# currently TRACKED in this repo, so anything in it is published to GitHub.
#
# The AI features are fail-closed: the key ALONE does nothing. Each feature
# also needs its endpoint, or it stays disabled and says so.
# ============================================================================
ANTHROPIC_API_KEY=
AI_CODING_ENDPOINT=
AI_DTR_ENDPOINT=
