# FHIR server specific
fhir/**/target/
fhir/**/*.class
fhir/**/*.jar
fhir/**/*.war

# Environment — never commit secrets
# Use .env.example as the template (that IS committed)
.env.local
.env.*.local

# Runtime config (contains FHIR URLs + auth, user-editable)
.rhtp-config.json

# E11 provenance check scratch artifact (created + deleted at runtime)
docs/build-provenance/.PROMPT_MASTER_LOG.committed

# Runtime artifacts — regenerated by tests / the E11 provenance generator (build_log.py).
# Tracking them made every gate run dirty the tree and block branch switches.
.audit/
docs/build-provenance/PROMPT_MASTER_LOG.xlsx
_to_delete/

# Relocated scratch/working dirs (moved to _to_delete/ during repo cleanup)
/_to_delete/
/_backups/
/_sync/
/standalone-smart-app-temp/
/New PA Plan Documents/
/Project Knowledge Uploads/
/Pricing/

# Local-only client/RFI docs pulled out of the repo (never tracked)
/_local-only/

# Never commit real env — only .env.example
.env

# Portable demo build outputs (generated)
dist-portable/

# Ship/staging bundles (scratch — incomplete app copies, must not be type-checked or committed)
_ship/

# ── Never committed: deliverables & build artifacts (policy — see AGENTS.md) ──
# Whitepapers, sales decks, and packaging/build outputs are deliverables, not source.
/whitepaper/
/packaging/
/*.pptx
/*.docx
/.next-portable/
/WPCO-Demo-Portable-Fast/
# scratch / backups
/devlog.txt
*.bak-hotfix
**/_to_delete_samples/

tools/cowork-plugin/*/dist/
tools/cowork-plugin/*.plugin

/Claude outputs/
