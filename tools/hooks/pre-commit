#!/usr/bin/env bash
# Versioned pre-commit hook — AI-CODING-CONVENTIONS.md v2 §18 + Agentic Build Framework.
# Enabled via `core.hooksPath tools/hooks` (package.json "prepare" sets it on npm install).
#
# The CHEAPEST rungs only, so commits stay fast. The EXPENSIVE rungs — tsc, full lint,
# unit tests, E11/E14 — run at pre-push (tools/hooks/pre-push -> scripts/ci-gates.sh push)
# and via `npm run gate:push` / `gate:pre-merge`. Running tsc here would make every commit
# take minutes on this repo, which is why the heavy checks live at push, not commit.
#
# SHIFT-LEFT (AI-CODING-CONVENTIONS §13.0.3): the RIGHT way to stop heavy debt piling up to
# the first push is NOT to slow every commit down — it is to run `npm run gate:push` (the same
# gate CI runs) after each logical chunk of work, so a type/lint/test regression surfaces in
# minutes, attributable to the chunk that caused it. For a shell that still wants the heavy
# rungs on every commit, set PRECOMMIT_FAST=1 (step 4 below) — off by default, on purpose.
set -e
cd "$(git rev-parse --show-toplevel)"

# 0) SECRET BLOCK — FAIL-CLOSED, runs first and costs milliseconds.
#    Added 2026-09-28 after an API key reached a remote. A scanner that only WARNS is the
#    same broken-control class this repo keeps finding: it reports and stops nothing. This
#    one EXITS NON-ZERO. The only bypass is `git commit --no-verify`, which is deliberate,
#    visible in your shell history, and yours to justify.
#    It never prints the matching line — printing a secret to a terminal is how it ends up
#    in a scrollback buffer, a screen share, or a CI log.
SEC_STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$SEC_STAGED" ]; then
  echo "[pre-commit] secret scan (fail-closed)"

  # 0a) env files must never be staged — only *.example templates may be.
  BAD_ENV=$(printf '%s\n' "$SEC_STAGED" | grep -E '(^|/)\.env($|\.)' | grep -v '\.example$' || true)
  if [ -n "$BAD_ENV" ]; then
    echo "  BLOCKED — env files are staged. These must never be committed:"
    printf '    %s\n' $BAD_ENV
    echo "  Real values belong in .env (gitignored). Commit a *.example template instead."
    exit 1
  fi

  # 0b) known credential formats in the staged CONTENT (added lines only).
  #     Each pattern requires a realistic length, so prose mentioning a bare prefix
  #     (documentation, this comment, a register entry) does NOT trip it.
  SEC_PAT='sk-ant-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  if git diff --cached --no-color -U0 2>/dev/null | grep -E '^\+' | grep -qE "$SEC_PAT"; then
    echo "  BLOCKED — staged content matches a known credential format."
    echo "  The matching line is deliberately NOT printed. Find it yourself with:"
    echo "    git diff --cached | grep -nE '"'"'$SEC_PAT'"'"'"
    echo "  Remove the value, put it in .env (gitignored), re-stage, commit again."
    exit 1
  fi
  echo "  clean — $(printf '%s\n' "$SEC_STAGED" | grep -c . ) staged file(s) scanned"
fi

# 1) Auto-format staged code with Prettier (repo .prettierrc == the lint gate's config), so
#    formatting can never fail the lint gate after the fact. Formatted files are re-staged.
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')
if [ -n "$FILES" ]; then
  echo "[pre-commit] prettier --write (staged)"
  # BOUNDED BATCHES (2026-09-29). Unbounded, this splats every staged file onto ONE command
  # line - 13,022 chars at 332 staged files. `npx` shells through cmd.exe on Windows, whose
  # limit is 8,191 ("The command line is too long"), and xargs' own buffer is 131,072 so it has
  # no reason to split on its own. scripts/ci-gates.sh g_format was bounded for exactly this
  # reason (-n 50 -s 6000); this hook - its twin - was not. Same fix, same numbers. NUL
  # separation so a path containing a space can never be split into two arguments.
  printf '%s\n' "$FILES" | tr '\n' '\0' | xargs -0 -r -n 50 -s 6000 npx --no-install prettier --write --ignore-unknown
  printf '%s\n' "$FILES" | tr '\n' '\0' | xargs -0 -r -n 50 -s 6000 git add
fi

# 1.5) Size preflight (ADVISORY) — print the ratchet status of every staged source file
#      BEFORE the gate below judges it, so an at-cap / baselined / landmine file is a named
#      heads-up at commit time, not a surprise at push. Never fails the commit itself (the
#      ratchet in step 2 is the real gate); run `npm run preflight` any time for the full set.
PF_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- src \
  | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$PF_STAGED" ]; then
  echo "[pre-commit] size preflight (advisory — see npm run preflight)"
  bash tools/preflight-files.sh $PF_STAGED || true
fi

# 2) File-size + quality ratchet (fast).
echo "[pre-commit] file sizes + quality ratchet"
bash check-file-sizes.sh

# 3) E13 test-link on staged source (symbol-aware; the fast half — mutation runs in CI).
STAGED=$(git diff --cached --name-only --diff-filter=AM -- 'src/*.ts' 'src/*.tsx' 2>/dev/null | tr '\n' ' ')
if [ -n "$STAGED" ]; then
  echo "[pre-commit] E13 test-link (staged source)"
  node docs/build-provenance/check-testlink.mjs src tests $STAGED --baseline docs/build-provenance/testlink-baseline.json
else
  echo "  (no staged source files)"
fi

# 4) OPTIONAL — full FAST tier (adds tsc + changed-file lint on top of the cheap rungs).
#    OFF by default (tsc is minutes on this repo; see header). Reuses the canonical gate rather
#    than re-implementing its logic, so it can never drift from CI. Opt in per-shell:
#      PRECOMMIT_FAST=1 git commit …
#    Prefer the shift-left habit (npm run gate:push per chunk) over turning this on globally.
if [ "${PRECOMMIT_FAST:-0}" = "1" ]; then
  echo "[pre-commit] PRECOMMIT_FAST=1 → scripts/ci-gates.sh fast (tsc + lint + sizes + E13)"
  bash scripts/ci-gates.sh fast
fi

echo "[pre-commit] OK — tsc + full lint + tests run at pre-push / npm run gate:push"
