#!/usr/bin/env bash
# Pre-push - run the canonical gate at the 'push' tier (Framework v1.6 §1).
# Enable once per clone:  git config core.hooksPath tools/hooks
# Mutation (minutes) is CI-only; everything else runs here so a red push is
# caught locally, not in CI. Emergency bypass:  git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
exec bash scripts/ci-gates.sh push
